{
  "name": "unibox",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:main": "turbo run dev --filter=@unibox/main",
    "dev:server": "turbo run dev --filter=@unibox/server",
    "dev:admin": "turbo run dev --filter=@unibox/admin",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "turbo": "^2.5.0"
  }
}
