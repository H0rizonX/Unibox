# 服务端口
PORT=3001

# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET=change-me-in-production

# JWT 过期时间（秒），默认 24 小时
JWT_EXPIRES_IN=86400

# MySQL 数据库（本地 Docker 默认配置，见 docker-compose.yml）
DATABASE_URL="mysql://unibox:unibox123@localhost:3306/unibox"

# CORS 允许的前端地址
CORS_ORIGIN=http://localhost:5173

# Redis（验证码缓存，见 docker-compose.yml）
REDIS_URL=redis://localhost:6379

# 验证码过期时间（秒），默认 3 分钟
OTP_TTL_SECONDS=180

# 应用名称（邮件标题中使用）
APP_NAME=Unibox

# SMTP 邮件配置（留空则在开发环境将验证码输出到控制台）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@unibox.com
